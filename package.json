{
  "name": "mots-flex",
  "version": "2.0.0",
  "description": "Generateur de mots fleches",
  "homepage": "https://github.com/Leo-Nicolle/mots-fleches",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "client",
    "database",
    "grid",
    "auto-fill",
    "server/api"
  ],
  "scripts": {
    "build:grid": "turbo run build --filter=grid",
    "build:database": "turbo run build --filter=database",
    "build:client": "turbo run build --filter=client",
    "build:server": "turbo run build --filter=motsflex-api",
    "build:dashboard": "cd dashboard && npm run build",
    "dev:dashboard": "cd dashboard && npm run dev",
    "predeploy:client": "npm run build:client",
    "deploy:client": "node scripts/deploy.mjs -w",
    "deploy:server": "node scripts/deploy.mjs -s",
    "deploy:config": "node scripts/deploy.mjs -c",
    "predeploy:all": "npm run build",
    "deploy:all": "node scripts/deploy.mjs -a",
    "prerender": "node scripts/prerender.mjs",
    "generate:seo-images": "node scripts/generate-seo-images.mjs",
    "build": "turbo run build --filter=grid --filter=database --filter=client && npm run prerender",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "cd client && playwright test",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev --parallel",
    "doc:grid": "cd grid && typedoc --plugin typedoc-plugin-markdown --out ../docs/grid src/index.ts",
    "doc:server": "cd server && typedoc --plugin typedoc-plugin-markdown --out ../docs/server lib/**/*.ts",
    "docdev:client": "vue-docgen -c docs/docgen.config.js -w",
    "doc:client": "vue-docgen -c docs/docgen.config.js",
    "docs:dev": "vuepress dev docs --config docs/vuepress.config.ts",
    "predocs:build": "npm run doc:server && npm run doc:grid && npm run doc:client",
    "predocs:publish": "npm run docs:build",
    "docs:publish": "gh-pages -d docs/.vuepress/dist",
    "docs:build": "vuepress build docs --config docs/vuepress.config.ts",
    "semantic-release": "semantic-release"
  },
  "author": "Leo Nicolle",
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Leo Nicolle",
      "email": "nicolle_leo@yahoo.fr"
    }
  ],
  "devDependencies": {
    "@angablue/exe": "^1.2.0",
    "@playwright/test": "^1.32.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^10.0.3",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vue/test-utils": "^2.3.1",
    "@eslint/js": "^9.21.0",
    "@vuepress/plugin-search": "next",
    "adm-zip": "^0.5.10",
    "decompress": "^4.2.1",
    "eslint": "^9.21.0",
    "execa": "^7.1.1",
    "fs-extra": "^11.1.0",
    "gh-pages": "^5.0.0",
    "globals": "^15.14.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^21.1.1",
    "markdown-it-html5-media": "^0.7.1",
    "pkg": "^5.8.1",
    "rimraf": "^4.4.0",
    "semantic-release": "^21.0.1",
    "typescript-eslint": "^8.25.0",
    "turbo": "^2.10.12",
    "typedoc": "^0.24.4",
    "typedoc-plugin-markdown": "^3.15.1",
    "vitest": "^0.29.5",
    "vue-docgen-cli": "^4.65.0",
    "vuepress": "next",
    "w-zip": "^1.0.15"
  },
  "pkgbuild": {
    "control": {
      "postbuild": "scripts/assets/postbuild.sh"
    },
    "content": {
      "usr/share/applications/mots-flex.desktop": "scripts/assets/mots-flex.desktop",
      "usr/share/mots-flex/": "build/",
      "/usr/share/icons/hicolor/scalable/apps/mots-flex.svg": "scripts/assets/icon.svg",
      "usr/bin/mots-flex": "scripts/assets/mots-flex"
    },
    "output": {
      "debian": {}
    },
    "name": "mots-flex",
    "title": "Mots-Flex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Leo-Nicolle/mots-fleches.git"
  }
}
