{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Client Test File",
      "autoAttachChildProcesses": true,
      "skipFiles": [],
      "cwd": "${workspaceRoot}/client",
      "program": "${workspaceRoot}/client/node_modules/vitest/vitest.mjs",
      "args": ["--config", "vitest.config.ts", "run", "${relativeFile}", "-u"],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server Test File",
      "autoAttachChildProcesses": true,
      "skipFiles": [],
      "cwd": "${workspaceRoot}/server/api",
      "program": "${workspaceRoot}/server/api/node_modules/vitest/vitest.mjs",
      "args": [
        "--config",
        "test/vitest.config.ts",
        "run",
        "${relativeFile}",
        "-u"
      ],
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
