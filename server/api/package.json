{
  "name": "motsflex-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "stripe-connect": "stripe listen --forward-to localhost:5480/api/webhook",
    "predev": "docker compose --env-file ../.env.dev --profile development restart",
    "dev": "nodemon --exec node -r esbuild-register src/index.ts",
    "type-check": "tsc --noEmit",
    "build": "npm run type-check && node esbuild.config.js",
    "prisma:pull": "dotenv -e ../.env.dev -- prisma db pull",
    "prisma:generate": "dotenv -e ../.env.dev -- prisma generate",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "pretest": "docker compose -f ../docker-compose.yml --env-file test/.env.test --profile test up -d --wait && dotenv -e test/.env.test -- prisma db push --skip-generate",
    "posttest": "docker compose -f ../docker-compose.yml --env-file test/.env.test --profile test down -v",
    "test": "vitest run -c test/vitest.config.ts "
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "parse-duration": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "stripe": "^17.7.0",
    "ws": "^8.19.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/stripe": "^8.0.417",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "nock": "^14.0.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.0.0",
    "vitest-mock-extended": "^3.1.0"
  }
}
