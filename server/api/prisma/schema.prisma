generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model books {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  grid_ids Json
  user_id  Int?
  group_id Int?
  groups   groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users    users?  @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model crosswords {
  id         Int       @id @default(autoincrement())
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  version    Int?      @default(1)
  user_id    Int?
  group_id   Int?
  groups     groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customwords {
  id       Int     @id @default(autoincrement())
  word     String  @db.VarChar(255)
  user_id  Int?
  group_id Int?
  groups   groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users    users?  @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([word], map: "idx_customwords_word")
}

model groupmembers {
  user_id  Int
  group_id Int
  role     String? @default("member") @db.VarChar(20)
  groups   groups  @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, group_id])
}

model groups {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(255)
  description  String?
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  owner_id     Int
  disk_usage   BigInt?        @default(0)
  tier_id      Int?           @default(1)
  expires_at   DateTime?      @db.Timestamp(6)
  bannedwords  bannedwords[]
  books        books[]
  crosswords   crosswords[]
  customwords  customwords[]
  fonts        fonts[]
  groupmembers groupmembers[]
  users        users          @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tiers        tiers?         @relation(fields: [tier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images       images[]
  payments     payments[]
  wordlists    wordlists[]
  words        words[]
}

model images {
  id       Int     @id @default(autoincrement())
  url      String
  user_id  Int?
  group_id Int?
  groups   groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users    users?  @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model payments {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  group_id    Int?
  amount      Decimal   @db.Decimal(10, 2)
  status      String?   @default("pending") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  payment_for String?   @default("user") @db.VarChar(20)
  groups      groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model tiers {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(50)
  price            Decimal  @db.Decimal(10, 2)
  max_users        Int?     @default(1)
  max_grids        Int?
  max_custom_words Int?
  max_disk_usage   BigInt?  @default(104857600)
  features         Json?
  groups           groups[]
  users            users[]
}

model users {
  id                       Int            @id @default(autoincrement())
  stripe_id                String?        @db.VarChar(255)
  email                    String         @unique @db.VarChar(255)
  password                 String
  created_at               DateTime?      @default(now()) @db.Timestamp(6)
  last_connection          DateTime?      @db.Timestamp(6)
  status                   String?        @default("active") @db.VarChar(20)
  disk_usage               BigInt?        @default(0)
  tier_id                  Int?           @default(1)
  refresh_token            String?
  refresh_token_expires_at DateTime?      @db.Timestamp(6)
  bannedwords              bannedwords[]
  books                    books[]
  crosswords               crosswords[]
  customwords              customwords[]
  fonts                    fonts[]
  groupmembers             groupmembers[]
  groups                   groups[]
  images                   images[]
  payments                 payments[]
  tiers                    tiers?         @relation(fields: [tier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wordlists                wordlists[]
  words                    words[]
  styles                   styles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wordlists {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  words      Json
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  version    Int?      @default(1)
  user_id    Int?
  group_id   Int?
  groups     groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([group_id], map: "idx_wordlists_group")
  @@index([user_id], map: "idx_wordlists_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model words {
  id         Int     @id @default(autoincrement())
  word       String  @db.VarChar(255)
  definition String
  language   String  @db.VarChar(10)
  user_id    Int?
  group_id   Int?
  groups     groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users      users?  @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([word], map: "idx_words_word")
}

model tokenblacklist {
  id         Int      @id @default(autoincrement())
  token      String
  expires_at DateTime @db.Timestamp(6)

  @@index([token], map: "idx_tokens_token")
}

model styles {
  id        Int    @id @default(autoincrement())
  client_id String @db.VarChar(255)
  data      Json
  user_id   Int?
  users     users? @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([client_id, user_id], map: "idx_styles_client_user")
  @@index([user_id], map: "idx_styles_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bannedwords {
  id       Int     @id @default(autoincrement())
  word     String  @db.VarChar(255)
  user_id  Int?
  group_id Int?
  groups   groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users    users?  @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fonts {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(255)
  file_url   String
  user_id    Int?
  group_id   Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  groups     groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([group_id], map: "idx_fonts_group")
  @@index([name], map: "idx_fonts_name")
  @@index([user_id], map: "idx_fonts_user")
}
