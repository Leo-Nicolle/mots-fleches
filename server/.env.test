# Test Environment Variables
# Used by `npm test` in server/api. All values are non-production dummies.
# The API loads this file instead of .env when NODE_ENV=test.

# Environment
ENVIRONMENT=test
MODE=test

CONTAINER_NAME=crosswords_test
DB_VOLUME_PATH=/dev/shm

# App
DB_HOST=db
PORT=5480
CLIENT_URL=http://localhost:5173

# PostgreSQL Configuration
POSTGRES_USER=crosswords_user
POSTGRES_PASSWORD=super_secure_password
POSTGRES_DB=crosswords_db
POSTGRES_DATA=/dev/shm  # Use a temporary volume for testing

# Conditional Port Exposure
DB_PORT=5534:5432
ADMINER_PORT=5535
DATABASE_URL=postgresql://crosswords_user:super_secure_password@localhost:5534/crosswords_db?schema=public

# JWT Configuration
JWT_SECRET=test_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_TOKEN_EXPIRES_IN=30m

# Dashboard admin access
ADMIN_TOKEN=test-admin-token

# Plausible analytics (self-hosted) proxy
PLAUSIBLE_API_KEY=test-plausible-api-key
PLAUSIBLE_SITE_ID=test.motsflex.com
PLAUSIBLE_API_BASE=http://localhost:8000

# SMTP (dummy values — mail is never actually sent in tests)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=test@example.com
SMTP_PASSWORD=test
SMTP_FROM=test@example.com
