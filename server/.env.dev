# Environment
ENVIRONMENT=development

CONTAINER_NAME=crosswords_dev
DB_VOLUME_PATH=postgres-data
# App
DB_HOST=db
PORT=5480
MODE=development
CLIENT_URL=http://localhost:5173
# PostgreSQL Configuration
POSTGRES_USER=crosswords_user
POSTGRES_PASSWORD=super_secure_password
POSTGRES_DB=crosswords_db
POSTGRES_DATA=./postgres-data:/var/lib/postgresql/data # Persistent data storage
# Conditional Port Exposure
DB_PORT=5434:5432  # Expose in development
ADMINER_PORT=5435
DATABASE_URL="postgresql://crosswords_user:super_secure_password@localhost:5434/crosswords_db?schema=public"

# Dashboard admin access
ADMIN_TOKEN=change-me-admin-token

# Plausible analytics (self-hosted) proxy
PLAUSIBLE_API_KEY=change-me-plausible-api-key
PLAUSIBLE_SITE_ID=motsflex.com
PLAUSIBLE_API_BASE=http://localhost:8000
